// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id                    String             @id @default(uuid())
  mrn                   String             @unique @default(cuid()) // Medical Record Number
  firstName             String
  middleName            String?
  lastName              String
  suffix                String?
  preferredName         String?
  previousName          String?
  dateOfBirth           DateTime
  gender                String
  genderIdentity        String?
  pronouns              String?
  contactNumber         String
  preferredContactMethod String            @default("cell")
  email                 String?
  noEmail               Boolean            @default(false)
  noEmailReason         String?
  address               String?
  addressLine2          String?
  city                  String?
  state                 String?
  zip                   String?
  country               String?            @default("US")
  homePhone             String?
  workPhone             String?
  cellPhone             String?
  governmentIdType      String?
  governmentIdNumber    String?
  birthPlace            String?
  veteranStatus         String?
  veteranStatusDetail   String?
  disabilityStatus      String?
  disabilityType        String?
  tribalAffiliation     String?
  generalNotes          String?            @db.Text
  ethnicity             String?
  sexualOrientation     String?
  race                  String?
  language              String?
  interpreterRequired   Boolean            @default(false)
  interpreterLanguageRequired String?
  maritalStatus         String?
  employmentStatus      String?
  employerName          String?
  occupation            String?
  employerPhoneNumber   String?
  employerStreetAddress String?
  employerCity          String?
  employerState         String?
  employerZip           String?
  otherInfo             String?            @db.Text
  prefix                String?
  ssnLast4              String?
  county                String?
  mailingSameAsResidential Boolean         @default(true)
  mailingAddress        String?
  mailingAddressLine2   String?
  mailingCity           String?
  mailingState          String?
  mailingZip            String?
  mailingCountry        String?            @default("US")
  governmentIdState     String?
  governmentIdExpiration DateTime?         @db.Date
  medicareBeneficiaryId String?
  medicaidId            String?
  preferredPharmacyName String?
  preferredPharmacyPhone String?
  preferredPharmacyAddress String?
  smsOptIn              Boolean            @default(false)
  emailOptIn            Boolean            @default(false)
  reminderOptIn         Boolean            @default(false)
  hipaaRoiName          String?
  hipaaRoiRelationship  String?
  hipaaRoiPhone         String?
  hipaaRoiEmail         String?
  advanceDirectiveOnFile Boolean           @default(false)
  advanceDirectiveType  String?
  powerOfAttorneyName   String?
  powerOfAttorneyPhone  String?
  workersCompClaimNumber String?
  autoAccidentClaimNumber String?
  billingNotes          String?            @db.Text
  accountBalance        Decimal?           @db.Decimal(10, 2)
  referredBy            String?
  countryOther          String?
  languageOther         String?
  allergyNotes          String?            @db.Text
  insuranceProviderId   String?
  insuranceProvider     InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id])
  policyNumber          String?
  copay                 Decimal?           @db.Decimal(10, 2)
  deductible            Decimal?           @db.Decimal(10, 2)
  primaryCarePhysician           String?
  referringPhysicianFirstName    String?
  referringPhysicianLastName     String?
  referringPhysicianNpi          String?
  referringPhysicianPhone        String?
  referringPhysicianFax          String?
  referringPhysicianAddress      String?
  referringPhysicianCity         String?
  referringPhysicianState        String?
  referringPhysicianZip          String?
  profilePhoto          String?            @db.Text
  emergencyContactName              String?
  emergencyContactNumber            String?
  emergencyContactRelationship      String?
  emergencyContactEmail             String?
  emergencyContactAddress           String?
  emergencyContactCity              String?
  emergencyContactState             String?
  emergencyContactZip               String?
  secondaryEmergencyContactName     String?
  secondaryEmergencyContactRelationship String?
  secondaryEmergencyContactNumber   String?
  secondaryEmergencyContactEmail    String?
  guarantorName                     String?
  guarantorPhone                    String?
  guarantorRelationship             String?
  guarantorEmail                    String?
  guarantorAddress                  String?
  guarantorCity                     String?
  guarantorState                    String?
  guarantorZip                      String?
  guarantorDateOfBirth              DateTime?
  authorizedRepresentativeName      String?
  authorizedRepresentativeRelationship String?
  authorizedRepresentativePhone     String?
  authorizedRepresentativeEmail     String?
  legalGuardianName                 String?
  legalGuardianRelationship         String?
  legalGuardianPhone                String?
  legalGuardianEmail                String?
  patientIsMinor                    Boolean            @default(false)
  primaryNextOfKinName              String?
  primaryNextOfKinRelationship      String?
  primaryNextOfKinPhone             String?
  secondaryNextOfKinName            String?
  secondaryNextOfKinRelationship    String?
  secondaryNextOfKinPhone           String?
  subscriberPhone                   String?
  subscriberSsnLast4                String?
  subscriberEmployer                String?
  subscriberAddress                 String?
  subscriberCity                    String?
  subscriberState                   String?
  subscriberZip                     String?
  subscriberEmail                   String?
  registrationStatus                String             @default("pending")
  registrationChannel               String?
  billingType                       String?
  paymentMethod                     String?
  primaryCareProviderId             String?
  assignedToId                      String?
  consentFormSigned                 Boolean            @default(false)
  noKnownDrugAllergies              Boolean            @default(false)
  chartStatus                       String             @default("active")
  deceasedAt                        DateTime?
  financialClass                    String?
  lastStatementAt                   DateTime?
  lastEligibilityAt                 DateTime?
  collectionStatus                  String?            @default("none")
  collectionNotes                   String?            @db.Text
  guarantorId                       String?
  mergedIntoId                      String?
  deletedAt                         DateTime?
  createdBy                         String?
  updatedBy                         String?
  deletedBy                         String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  appointments          Appointment[]
  waitlistEntries       WaitlistEntry[]
  orders                Order[]
  beds                  Bed[]
  ledgerTransactions    LedgerTransaction[]
  priorAuthorizations   PriorAuthorization[]
  notificationLogs      NotificationLog[]
  referralRecords       ReferralRecord[]
  appointmentPayments   AppointmentPayment[]
  paymentAllocations    PaymentAllocation[]
  primaryCareProvider   Provider?          @relation("PatientPrimaryCareProvider", fields: [primaryCareProviderId], references: [id], onDelete: SetNull)
  assignedTo            User?              @relation("AssignedPatients", fields: [assignedToId], references: [id], onDelete: SetNull)
  creator               User?              @relation("CreatedPatients", fields: [createdBy], references: [id], onDelete: SetNull)
  updater               User?              @relation("UpdatedPatients", fields: [updatedBy], references: [id], onDelete: SetNull)
  deleter               User?              @relation("DeletedPatients", fields: [deletedBy], references: [id], onDelete: SetNull)
  guarantorAccount      Guarantor?         @relation(fields: [guarantorId], references: [id], onDelete: SetNull)
  mergedInto            Patient?           @relation("PatientMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom            Patient[]          @relation("PatientMerge")
  mergeLogsAsSource     PatientMergeLog[]  @relation("MergeSource")
  mergeLogsAsTarget     PatientMergeLog[]  @relation("MergeTarget")
  insurances            PatientInsurance[]
  documents             PatientDocument[]
  consentSignatures     PatientConsentSignature[]
  problems              PatientProblem[]
  allergies             PatientAllergy[]
  eligibilityChecks     InsuranceEligibility[]
  intakeSections        PatientIntakeSection[]
  intakeCompletions     PatientIntakeCompletion[]
  screeningScores       PatientScreeningScore[]
  clinicalNotes         PatientClinicalNote[]
  statements            PatientStatement[]
  claims                PatientClaim[]

  @@index([registrationStatus])
  @@index([chartStatus])
  @@index([assignedToId])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([guarantorId])
  @@index([collectionStatus])
  @@index([mergedIntoId])
  @@map("patients")
}

model Guarantor {
  id            String    @id @default(uuid())
  firstName     String
  lastName      String
  middleName    String?
  relationship  String?   @default("self")
  dateOfBirth   DateTime? @db.Date
  phone         String?
  email         String?
  address       String?
  addressLine2  String?
  city          String?
  state         String?
  zip           String?
  ssnLast4      String?
  employerName  String?
  notes         String?   @db.Text
  isActive      Boolean   @default(true)
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  patients      Patient[]

  @@index([lastName, firstName])
  @@index([isActive])
  @@map("guarantors")
}

model PaymentAllocation {
  id                   String   @id @default(uuid())
  patientId            String
  paymentTransactionId String
  chargeTransactionId  String
  amount               Decimal  @db.Decimal(12, 2)
  notes                String?
  createdBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  patient              Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  paymentTransaction   LedgerTransaction @relation("AllocationPayment", fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  chargeTransaction    LedgerTransaction @relation("AllocationCharge", fields: [chargeTransactionId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([paymentTransactionId])
  @@index([chargeTransactionId])
  @@map("payment_allocations")
}

model PatientMergeLog {
  id             String   @id @default(uuid())
  sourcePatientId String
  targetPatientId String
  summary        String?
  details        Json?
  mergedBy       String?
  mergedAt       DateTime @default(now())
  sourcePatient  Patient  @relation("MergeSource", fields: [sourcePatientId], references: [id], onDelete: Cascade)
  targetPatient  Patient  @relation("MergeTarget", fields: [targetPatientId], references: [id], onDelete: Cascade)

  @@index([sourcePatientId])
  @@index([targetPatientId])
  @@index([mergedAt])
  @@map("patient_merge_logs")
}

model PatientStatement {
  id               String   @id @default(uuid())
  patientId        String
  statementNumber  String   @unique
  periodFrom       DateTime? @db.Date
  periodTo         DateTime? @db.Date
  balance          Decimal  @db.Decimal(12, 2)
  status           String   @default("generated")
  notes            String?  @db.Text
  snapshot         Json?
  deliveryChannel  String?
  deliveryError    String?
  generatedBy      String?
  generatedAt      DateTime @default(now())
  printedAt        DateTime?
  sentAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([generatedAt])
  @@index([status])
  @@map("patient_statements")
}

model PatientClaim {
  id                     String    @id @default(uuid())
  patientId              String
  appointmentId          String?
  claimNumber            String
  claimStatus            String    @default("draft")
  claimType              String    @default("original")
  formType               String    @default("CMS-1500")
  payerName              String?
  memberId               String?
  groupNumber            String?
  billingProviderNpi     String?
  renderingProviderNpi   String?
  placeOfService         String?
  frequencyCode          String?   @default("1")
  billedAmount           Decimal?  @db.Decimal(12, 2)
  allowedAmount          Decimal?  @db.Decimal(12, 2)
  paidAmount             Decimal?  @db.Decimal(12, 2)
  adjustmentAmount       Decimal?  @db.Decimal(12, 2)
  patientResponsibility  Decimal?  @db.Decimal(12, 2)
  denialReason           String?
  denialCode             String?
  tcn                    String?
  controlNumber          String?
  scrubStatus            String?   @default("pending")
  scrubIssues            Json?
  clearinghouseStatus    String?
  formPayload            Json?
  submittedAt            DateTime?
  acceptedAt             DateTime?
  rejectedAt             DateTime?
  paidAt                 DateTime?
  notes                  String?   @db.Text
  renderingProviderId    String?
  billingProviderId      String?
  supervisingProviderId  String?
  orderingProviderId     String?
  referringProviderId    String?
  facilityId             String?
  primaryPayerId         String?
  secondaryPayerId       String?
  tertiaryPayerId        String?
  submissionStatus       String    @default("not_submitted")
  totalCharge            Decimal?  @db.Decimal(12, 2)
  patientBalance         Decimal?  @db.Decimal(12, 2)
  officeLocation         String?
  claimRef               String?
  savedAt                DateTime?
  deletedAt              DateTime?
  sourceClaimId          String?
  splitFromClaimId       String?
  createdBy              String?
  updatedBy              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  patient                Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment            Appointment? @relation("PatientClaims", fields: [appointmentId], references: [id], onDelete: SetNull)
  renderingProvider      Provider? @relation("ClaimRenderingProvider", fields: [renderingProviderId], references: [id], onDelete: SetNull)
  billingProvider        BillingProvider? @relation("ClaimBillingProvider", fields: [billingProviderId], references: [id], onDelete: SetNull)
  supervisingProvider    Provider? @relation("ClaimSupervisingProvider", fields: [supervisingProviderId], references: [id], onDelete: SetNull)
  orderingProvider       Provider? @relation("ClaimOrderingProvider", fields: [orderingProviderId], references: [id], onDelete: SetNull)
  referringProvider      Provider? @relation("ClaimReferringProvider", fields: [referringProviderId], references: [id], onDelete: SetNull)
  facility               Location? @relation("ClaimFacility", fields: [facilityId], references: [id], onDelete: SetNull)
  primaryPayer           InsuranceProvider? @relation("ClaimPrimaryPayer", fields: [primaryPayerId], references: [id], onDelete: SetNull)
  secondaryPayer         InsuranceProvider? @relation("ClaimSecondaryPayer", fields: [secondaryPayerId], references: [id], onDelete: SetNull)
  tertiaryPayer          InsuranceProvider? @relation("ClaimTertiaryPayer", fields: [tertiaryPayerId], references: [id], onDelete: SetNull)
  lines                  ClaimLine[]
  events                 ClaimEvent[]
  ediTransactions        EdiTransaction[]
  eraLines               EraLine[]
  denials                DenialCase[]
  followUpTasks          FollowUpTask[]
  diagnoses              ClaimDiagnosis[]
  insurances             ClaimInsurance[]
  additionalInfo         ClaimAdditionalInfo?
  ambulanceInfo          ClaimAmbulanceInfo?
  chargeHistory          ClaimChargeHistory[]

  @@unique([claimNumber])
  @@index([patientId])
  @@index([appointmentId])
  @@index([claimStatus])
  @@index([tcn])
  @@index([formType])
  @@index([deletedAt])
  @@index([renderingProviderId])
  @@index([billingProviderId])
  @@index([facilityId])
  @@index([primaryPayerId])
  @@index([submissionStatus])
  @@map("patient_claims")
}

model ClaimLine {
  id                String   @id @default(uuid())
  claimId           String
  lineNumber        Int
  serviceDate       DateTime? @db.Date
  serviceToDate     DateTime? @db.Date
  cptCode           String?
  hcpcsCode         String?
  modifiers         String?
  modifier1         String?
  modifier2         String?
  modifier3         String?
  modifier4         String?
  diagnosisPointers String?
  units             Decimal  @default(1) @db.Decimal(10, 2)
  unitCharge        Decimal  @db.Decimal(12, 2)
  chargeAmount      Decimal  @db.Decimal(12, 2)
  allowedAmount     Decimal? @db.Decimal(12, 2)
  paidAmount        Decimal? @db.Decimal(12, 2)
  placeOfService    String?
  typeOfService     String?
  inventoryCode     String?
  chiropractic      Boolean  @default(false)
  chargeStatus      String   @default("no_change")
  revenueCode       String?
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  claim             PatientClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  history           ClaimChargeHistory[]

  @@index([claimId])
  @@index([cptCode])
  @@index([chargeStatus])
  @@map("claim_lines")
}

model ClaimEvent {
  id          String   @id @default(uuid())
  claimId     String
  eventType   String
  fromStatus  String?
  toStatus    String?
  summary     String?
  details     Json?
  createdBy   String?
  createdAt   DateTime @default(now())
  claim       PatientClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([eventType])
  @@index([createdAt])
  @@map("claim_events")
}

model ClaimDiagnosis {
  id              String   @id @default(uuid())
  claimId         String
  pointer         String
  sortOrder       Int      @default(0)
  diagnosisCodeId String?
  code            String?
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  claim           PatientClaim  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  diagnosisCode   DiagnosisCode? @relation(fields: [diagnosisCodeId], references: [id], onDelete: SetNull)

  @@unique([claimId, pointer])
  @@index([claimId])
  @@index([diagnosisCodeId])
  @@map("claim_diagnoses")
}

model ClaimInsurance {
  id                     String    @id @default(uuid())
  claimId                String
  tier                   String
  payerId                String?
  memberId               String?
  groupNumber            String?
  policyType             String?
  subscriberFirstName    String?
  subscriberLastName     String?
  subscriberName         String?
  subscriberDob          DateTime? @db.Date
  subscriberRelationship String?
  copayDue               Decimal?  @db.Decimal(10, 2)
  authorizationNumber    String?
  referralType           String?
  claimControlRef        String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  claim                  PatientClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  payer                  InsuranceProvider? @relation("ClaimInsurancePayer", fields: [payerId], references: [id], onDelete: SetNull)

  @@unique([claimId, tier])
  @@index([claimId])
  @@index([payerId])
  @@map("claim_insurances")
}

model ClaimAdditionalInfo {
  id                        String    @id @default(uuid())
  claimId                   String    @unique
  employmentRelated         Boolean   @default(false)
  autoAccident              Boolean   @default(false)
  accidentState             String?
  otherAccident             Boolean   @default(false)
  onsetDate                 DateTime? @db.Date
  lastMenstrualPeriod       DateTime? @db.Date
  initialTreatmentDate      DateTime? @db.Date
  similarIllnessDate        DateTime? @db.Date
  dateLastSeen              DateTime? @db.Date
  unableToWorkFrom          DateTime? @db.Date
  unableToWorkTo            DateTime? @db.Date
  hospitalizationFrom       DateTime? @db.Date
  hospitalizationTo         DateTime? @db.Date
  patientHomebound          String?
  outsideLab                Boolean   @default(false)
  labCharge                 Decimal?  @db.Decimal(12, 2)
  priorAuthorizationNumber  String?
  originalReferenceNumber   String?
  resubmissionCode          String?
  claimCodes                String?
  otherClaimId              String?
  additionalClaimInfo       String?
  notes                     String?   @db.Text
  delayReasonCode           String?
  specialProgramCode        String?
  patientSignatureOnFile    String?
  insuredSignatureOnFile    String?
  providerAcceptAssignment  String?
  documentationMethod       String?
  documentationType         String?
  documentationTypeOther    String?
  patientHeight             String?
  patientWeight             String?
  serviceAuthException      String?
  demonstrationProject      String?
  mammographyCert           String?
  investigationalDevice     String?
  ambulatoryPatientGroup    String?
  showBoxNumbers            String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  claim                     PatientClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@map("claim_additional_info")
}

model ClaimAmbulanceInfo {
  id                         String    @id @default(uuid())
  claimId                    String    @unique
  isAmbulanceClaim           Boolean   @default(false)
  ambulanceTransportReason   String?
  pickupLocation             String?
  dropoffLocation            String?
  pickupDate                 DateTime? @db.Date
  pickupTime                 String?
  mileage                    Decimal?  @db.Decimal(10, 2)
  ambulanceProvider          String?
  origin                     String?
  destination                String?
  transportType              String?
  medicalNecessity           String?
  notes                      String?   @db.Text
  transportMiles             Decimal?  @db.Decimal(10, 2)
  patientWeight              Decimal?  @db.Decimal(10, 2)
  roundTripReason            String?
  stretcherReason            String?
  pickupAddress              Json?
  dropoffAddress             Json?
  certifications             Json?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  claim                      PatientClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@map("claim_ambulance_info")
}

model ClaimChargeHistory {
  id            String   @id @default(uuid())
  claimId       String
  claimChargeId String?
  action        String
  fieldName     String?
  oldValue      String?
  newValue      String?
  reason        String?
  changedBy     String?
  changedAt     DateTime @default(now())
  claim         PatientClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  charge        ClaimLine?   @relation(fields: [claimChargeId], references: [id], onDelete: SetNull)

  @@index([claimId])
  @@index([claimChargeId])
  @@index([changedAt])
  @@map("claim_charge_history")
}

model EncounterBilling {
  id              String   @id @default(uuid())
  appointmentId   String   @unique
  patientId       String
  billingStatus   String   @default("Unbilled")
  diagnoses       Json     @default("[]")
  charges         Json     @default("[]")
  payments        Json     @default("[]")
  followUpNotes   Json     @default("[]")
  auditTrail      Json     @default("[]")
  meta            Json?
  claimId         String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([billingStatus])
  @@map("encounter_billings")
}

model EdiTransaction {
  id                String   @id @default(uuid())
  claimId           String?
  transactionType   String
  direction         String   @default("outbound")
  controlNumber     String?
  status            String   @default("queued")
  payload           Json?
  responsePayload   Json?
  errorMessage      String?
  providerName      String?  @default("mock-clearinghouse")
  createdBy         String?
  sentAt            DateTime?
  acknowledgedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  claim             PatientClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([claimId])
  @@index([transactionType])
  @@index([status])
  @@map("edi_transactions")
}

model EraBatch {
  id              String   @id @default(uuid())
  batchNumber     String   @unique
  payerName       String?
  checkNumber     String?
  checkDate       DateTime? @db.Date
  totalPayment    Decimal  @db.Decimal(12, 2) @default(0)
  status          String   @default("imported")
  rawPayload      Json?
  importedBy      String?
  postedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lines           EraLine[]

  @@index([status])
  @@index([createdAt])
  @@map("era_batches")
}

model EraLine {
  id                String   @id @default(uuid())
  eraBatchId        String
  claimId           String?
  patientId         String?
  claimNumber       String?
  tcn               String?
  billedAmount      Decimal? @db.Decimal(12, 2)
  paidAmount        Decimal  @db.Decimal(12, 2) @default(0)
  adjustmentAmount  Decimal  @db.Decimal(12, 2) @default(0)
  patientResponsibility Decimal? @db.Decimal(12, 2)
  denialCode        String?
  denialReason      String?
  status            String   @default("pending")
  ledgerPaymentId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  eraBatch          EraBatch @relation(fields: [eraBatchId], references: [id], onDelete: Cascade)
  claim             PatientClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([eraBatchId])
  @@index([claimId])
  @@index([status])
  @@map("era_lines")
}

model DenialCase {
  id              String   @id @default(uuid())
  claimId         String
  patientId       String
  denialCode      String?
  denialReason    String?
  carcCode        String?
  rarcCode        String?
  status          String   @default("open")
  deniedAmount    Decimal? @db.Decimal(12, 2)
  assignedTo      String?
  dueDate         DateTime? @db.Date
  notes           String?  @db.Text
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  claim           PatientClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  appeals         AppealCase[]

  @@index([claimId])
  @@index([patientId])
  @@index([status])
  @@map("denial_cases")
}

model AppealCase {
  id              String   @id @default(uuid())
  denialId        String
  claimId         String
  status          String   @default("draft")
  appealLevel     Int      @default(1)
  reason          String?
  submittedAt     DateTime?
  decisionAt      DateTime?
  decision        String?
  notes           String?  @db.Text
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  denial          DenialCase @relation(fields: [denialId], references: [id], onDelete: Cascade)

  @@index([denialId])
  @@index([claimId])
  @@index([status])
