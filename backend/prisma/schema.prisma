// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id                    String             @id @default(uuid())
  mrn                   String             @unique // Medical Record Number — MRN000000000001
  firstName             String
  middleName            String?
  lastName              String
  suffix                String?
  preferredName         String?
  previousName          String?
  dateOfBirth           DateTime
  gender                String
  genderIdentity        String?
  pronouns              String?
  ssn                   String?
  contactNumber         String
  preferredContactMethod String            @default("cell")
  email                 String?
  address               String?
  addressLine2          String?
  city                  String?
  state                 String?
  zip                   String?
  country               String?            @default("US")
  homePhone             String?
  workPhone             String?
  cellPhone             String?
  governmentIdType      String?
  governmentIdNumber    String?
  birthPlace            String?
  veteranStatus         String?
  disabilityStatus      String?
  tribalAffiliation     String?
  generalNotes          String?            @db.Text
  ethnicity             String?
  sexualOrientation     String?
  race                  String?
  language              String?
  interpreterRequired   Boolean            @default(false)
  interpreterLanguageRequired String?
  maritalStatus         String?
  employmentStatus      String?
  employerName          String?
  occupation            String?
  employerPhoneNumber   String?
  employerStreetAddress String?
  employerCity          String?
  employerState         String?
  employerZip           String?
  otherInfo             String?            @db.Text
  insuranceProviderId   String?
  insuranceProvider     InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id])
  policyNumber          String?
  copay                 Decimal?           @db.Decimal(10, 2)
  deductible            Decimal?           @db.Decimal(10, 2)
  primaryCarePhysician           String?
  referringPhysicianFirstName    String?
  referringPhysicianLastName     String?
  referringPhysicianNpi          String?
  referringPhysicianPhone        String?
  referringPhysicianFax          String?
  referringPhysicianAddress      String?
  referringPhysicianCity         String?
  referringPhysicianState        String?
  referringPhysicianZip          String?
  profilePhoto          String?            @db.Text
  emergencyContactName              String?
  emergencyContactNumber            String?
  emergencyContactRelationship      String?
  emergencyContactEmail             String?
  emergencyContactAddress           String?
  emergencyContactCity              String?
  emergencyContactState             String?
  emergencyContactZip               String?
  secondaryEmergencyContactName     String?
  secondaryEmergencyContactRelationship String?
  secondaryEmergencyContactNumber   String?
  secondaryEmergencyContactEmail    String?
  guarantorName                     String?
  guarantorPhone                    String?
  guarantorRelationship             String?
  guarantorEmail                    String?
  guarantorAddress                  String?
  guarantorCity                     String?
  guarantorState                    String?
  guarantorZip                      String?
  guarantorDateOfBirth              DateTime?
  authorizedRepresentativeName      String?
  authorizedRepresentativeRelationship String?
  authorizedRepresentativePhone     String?
  authorizedRepresentativeEmail     String?
  legalGuardianName                 String?
  legalGuardianRelationship         String?
  legalGuardianPhone                String?
  legalGuardianEmail                String?
  patientIsMinor                    Boolean            @default(false)
  primaryNextOfKinName              String?
  primaryNextOfKinRelationship      String?
  primaryNextOfKinPhone             String?
  secondaryNextOfKinName            String?
  secondaryNextOfKinRelationship    String?
  secondaryNextOfKinPhone           String?
  subscriberPhone                   String?
  subscriberSsnLast4                String?
  subscriberEmployer                String?
  subscriberAddress                 String?
  subscriberCity                    String?
  subscriberState                   String?
  subscriberZip                     String?
  subscriberEmail                   String?
  registrationStatus                String             @default("pending")
  registrationChannel               String?
  billingType                       String?
  paymentMethod                     String?
  primaryCareProviderId             String?
  assignedToId                      String?
  consentFormSigned                 Boolean            @default(false)
  noKnownDrugAllergies              Boolean            @default(false)
  noEmail                           Boolean            @default(false)
  militaryBranch                    String?
  disabilities                      String?            @db.Text
  interpreterLanguages              String?            @db.Text
  visitModality                     String?
  accessibilityRequirements         String?            @db.Text
  accessibilityRequirementsNotes    String?            @db.Text
  deletedAt                         DateTime?
  createdBy                         String?
  updatedBy                         String?
  deletedBy                         String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  appointments          Appointment[]
  orders                Order[]
  beds                  Bed[]
  primaryCareProvider   Provider?          @relation("PatientPrimaryCareProvider", fields: [primaryCareProviderId], references: [id], onDelete: SetNull)
  assignedTo            User?              @relation("AssignedPatients", fields: [assignedToId], references: [id], onDelete: SetNull)
  creator               User?              @relation("CreatedPatients", fields: [createdBy], references: [id], onDelete: SetNull)
  updater               User?              @relation("UpdatedPatients", fields: [updatedBy], references: [id], onDelete: SetNull)
  deleter               User?              @relation("DeletedPatients", fields: [deletedBy], references: [id], onDelete: SetNull)
  insurances            PatientInsurance[]
  documents             PatientDocument[]
  consentSignatures     PatientConsentSignature[]
  activityLogs          PatientActivityLog[]
  allergies             PatientAllergy[]
  problems              PatientProblem[]
  encounterProblems     EncounterProblem[]
  eligibilityVerifications InsuranceEligibilityVerification[]
  intakeRecords         PatientIntakeRecord[]
  intakeStatuses        PatientIntakeStatus[]
  medicationOrders      MedicationOrder[]
  medicationMarEntries  MedicationMarEntry[]
  referrals             PatientReferral[]
  checkouts             PatientCheckout[]
  chargeCaptures        EncounterChargeCapture[]
  claims                Claim[]
  chronicDiseaseEncounters ChronicDiseaseEncounter[]

  @@index([registrationStatus])
  @@index([assignedToId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("patients")
}

model PatientInsurance {
  id                      String            @id @default(uuid())
  patientId               String
  insuranceType           String
  insuranceProviderId     String
  memberId                String
  policyType              String?
  planName                String?
  groupNumber             String?
  subscriberFirstName     String?
  subscriberLastName      String?
  subscriberRelationship  String?
  subscriberGender        String?
  subscriberDateOfBirth   DateTime?
  subscriberPhone         String?
  subscriberEmail         String?
  subscriberSsnLast4      String?
  subscriberEmployer      String?
  subscriberStreetAddress String?
  subscriberCity          String?
  subscriberState         String?
  subscriberZip           String?
  coverageStartDate       DateTime?         @db.Date
  coverageEndDate         DateTime?         @db.Date
  coinsurancePercentage   Decimal?          @db.Decimal(5, 2)
  copay                   Decimal?          @db.Decimal(10, 2)
  deductible              Decimal?          @db.Decimal(10, 2)
  authorizationNumber     String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  patient                 Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  insuranceProvider       InsuranceProvider @relation(fields: [insuranceProviderId], references: [id], onDelete: Restrict)

  @@unique([patientId, insuranceType])
  @@index([patientId])
  @@index([insuranceProviderId])
  @@map("patient_insurances")
}

model PatientDocument {
  id               String            @id @default(uuid())
  patientId        String
  title            String?
  documentType     String
  category         String?
  source           String            @default("Patient Dashboard")
  encounterId      String?
  description      String?           @db.Text
  documentDate     DateTime?         @db.Date
  expirationDate   DateTime?         @db.Date
  isConfidential   Boolean           @default(false)
  patientVisible   Boolean           @default(false)
  tags             Json?
  status           String            @default("Active")
  fileName         String?
  fileData         String?           @db.Text
  mimeType         String?
  fileSize         Int?
  uploadedBy       String?
  updatedBy        String?
  verifiedBy       String?
  verifiedAt       DateTime?
  parentDocumentId String?
  versionNumber    Int               @default(1)
  replaceReason    String?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  parentDocument   PatientDocument?  @relation("DocumentVersions", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  versions         PatientDocument[] @relation("DocumentVersions")

  @@index([patientId])
  @@index([documentType])
  @@index([category])
  @@index([source])
  @@index([status])
  @@index([parentDocumentId])
  @@map("patient_documents")
}

model PatientConsentSignature {
  id              String      @id @default(uuid())
  patientId       String
  consentFormId   String
  signedAt        DateTime    @default(now())
  signedByUserId  String?
  signatureType   String
  signatureData   String      @db.Text
  scrolledToEnd   Boolean     @default(false)
  nameMatched     Boolean     @default(false)
  patient         Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consentForm     ConsentForm @relation(fields: [consentFormId], references: [id], onDelete: Restrict)
  signedBy        User?       @relation("PatientConsentSignatures", fields: [signedByUserId], references: [id], onDelete: SetNull)

  @@unique([patientId, consentFormId])
  @@index([patientId])
  @@map("patient_consent_signatures")
}

model PatientActivityLog {
  id        String   @id @default(uuid())
  patientId String
  action    String
  section   String?
  tabName   String?
  userId    String?
  userName  String?
  userRole  String?
  changes   Json?
  createdAt DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([createdAt])
  @@map("patient_activity_logs")
}

model PatientAllergy {
  id           String    @id @default(uuid())
  patientId    String
  allergenName String
  reaction     String?
  severity     String?
  onsetDate    DateTime? @db.Date
  status       String    @default("Active")
  comment      String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_allergies")
}

model PatientProblem {
  id                   String         @id @default(uuid())
  patientId            String
  diagnosisId          String?
  icd10Code            String?
  diagnosisDescription String
  status               String         @default("Active")
  clinicalStatus       String?
  verificationStatus   String?
  problemType          String? // Acute | Chronic | Both
  acuity               String? // Mild | Moderate | Severe
  onsetDate            DateTime?      @db.Date
  resolvedDate         DateTime?      @db.Date
  notes                String?        @db.Text
  deletedAt            DateTime?
  createdBy            String
  updatedBy            String
  deletedBy            String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  patient              Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  diagnosis            DiagnosisCode? @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  creator              User           @relation("CreatedPatientProblems", fields: [createdBy], references: [id])
  updater              User           @relation("UpdatedPatientProblems", fields: [updatedBy], references: [id])
  deleter              User?          @relation("DeletedPatientProblems", fields: [deletedBy], references: [id])
  encounterProblems    EncounterProblem[]
  encounterDiagnoses   EncounterDiagnosis[]

  @@index([patientId])
  @@index([diagnosisId])
  @@index([status])
  @@index([deletedAt])
  @@map("patient_problems")
}

/// Visit-scoped use of a patient problem (addressed today, primary, A/P).
model EncounterProblem {
  id                 String         @id @default(uuid())
  appointmentId      String
  patientId          String
  problemId          String
  addressedThisVisit Boolean        @default(false)
  isPrimary          Boolean        @default(false)
  priority           Int?
  assessment         String?        @db.Text
  plan               String?        @db.Text
  createdBy          String
  updatedBy          String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  appointment        Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient            Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  problem            PatientProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  creator            User           @relation("CreatedEncounterProblems", fields: [createdBy], references: [id])
  updater            User           @relation("UpdatedEncounterProblems", fields: [updatedBy], references: [id])

  @@unique([appointmentId, problemId])
  @@index([appointmentId])
  @@index([patientId])
  @@index([problemId])
  @@index([addressedThisVisit])
  @@map("encounter_problems")
}

model InsuranceEligibilityVerification {
  id         String   @id @default(uuid())
  patientId  String
  status     String
  verifiedAt DateTime @default(now())
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([verifiedAt])
  @@map("insurance_eligibility_verifications")
}

model PatientIntakeRecord {
  id            String    @id @default(uuid())
  patientId     String
  appointmentId String?
  sectionType   String
  payload       Json
  score         Int?
  notes         String?   @db.Text
  isAddendum    Boolean   @default(false)
  parentId      String?
  createdBy     String?
  updatedBy     String?
  createdByName String?
  updatedByName String?
  isDeleted     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  parent        PatientIntakeRecord? @relation("IntakeAddendums", fields: [parentId], references: [id], onDelete: SetNull)
  addendums     PatientIntakeRecord[] @relation("IntakeAddendums")

  @@index([patientId])
  @@index([appointmentId])
  @@index([sectionType])
  @@index([parentId])
  @@map("patient_intake_records")
}

model PatientIntakeStatus {
  id              String    @id @default(uuid())
  patientId       String
  appointmentId   String?
  certifiedAt     DateTime?
  certifiedBy     String?
  certifiedByName String?
  completedAt     DateTime?
  completedBy     String?
  completedByName String?
  completionNotes String?   @db.Text
  status          String    @default("in_progress")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([appointmentId])
  @@map("patient_intake_status")
}

model InsuranceProvider {
  id           String    @id @default(uuid())
  name         String
  code         String? // Short code like "BCBS", "AETNA"
  phone        String?
  email        String?
  address      String?
  city         String?
  state        String?
  zip          String?
  website      String?
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  deletedBy    String?
  patients     Patient[]
  patientInsurances PatientInsurance[]
  deleter      User?     @relation("DeletedInsuranceProviders", fields: [deletedBy], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([deletedAt])
  @@map("insurance_providers")
}

model ChiefComplaint {
  id         String    @id @default(uuid())
  name       String
  code       String?
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  deletedAt  DateTime?
  createdBy  String
  updatedBy  String
  deletedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  creator    User      @relation("CreatedChiefComplaints", fields: [createdBy], references: [id])
  updater    User      @relation("UpdatedChiefComplaints", fields: [updatedBy], references: [id])
  deleter    User?     @relation("DeletedChiefComplaints", fields: [deletedBy], references: [id])
  favourites UserChiefComplaintFavourite[]

  @@index([name])
  @@index([deletedAt])
  @@map("chief_complaints")
}

model UserChiefComplaintFavourite {
  userId           String
  chiefComplaintId String
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chiefComplaint   ChiefComplaint @relation(fields: [chiefComplaintId], references: [id], onDelete: Cascade)

  @@id([userId, chiefComplaintId])
  @@map("user_chief_complaint_favourites")
}

model ConsentForm {
  id                         String    @id @default(uuid())
  consentTitle               String
  consentType                String
  description                String?
  consentContent             String    @db.Text
  isMandatory                Boolean   @default(false)
  isSignatureRequired        Boolean   @default(true)
  patientSignaturePlacement  String?
  requiresWitnessSignature   Boolean   @default(false)
  witnessSignaturePlacement  String?
  requiresProviderSignature  Boolean   @default(false)
  providerSignaturePlacement String?
  effectiveDate              DateTime? @db.Date
  expiryDate                 DateTime? @db.Date
  status                     String    @default("draft")
  department                 String?
  language                   String?
  versionNumber              String?
  tags                       String?
  attachmentName             String?
  attachmentDataUrl          String?   @db.Text
  deletedAt                  DateTime?
  createdBy                  String
  updatedBy                  String
  deletedBy                  String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  creator                    User      @relation("CreatedConsentForms", fields: [createdBy], references: [id])
  updater                    User      @relation("UpdatedConsentForms", fields: [updatedBy], references: [id])
  deleter                    User?     @relation("DeletedConsentForms", fields: [deletedBy], references: [id])
  patientSignatures          PatientConsentSignature[]

  @@index([consentTitle])
  @@index([consentType])
  @@index([status])
  @@index([deletedAt])
  @@map("consent_forms")
}

model ProcedureCategory {
  id         String                         @id @default(uuid())
  name       String
  deletedAt  DateTime?
  createdBy  String
  updatedBy  String
  deletedBy  String?
  createdAt  DateTime                       @default(now())
  updatedAt  DateTime                       @updatedAt
  creator    User                           @relation("CreatedProcedureCategories", fields: [createdBy], references: [id])
  updater    User                           @relation("UpdatedProcedureCategories", fields: [updatedBy], references: [id])
  deleter    User?                          @relation("DeletedProcedureCategories", fields: [deletedBy], references: [id])
  procedures ProcedureCategoryOnProcedure[]

  @@index([name])
  @@index([deletedAt])
  @@map("procedure_categories")
}

model Procedure {
  id                   String                         @id @default(uuid())
  procedureDescription String
  genericDescription   String?
  departmentId         String?
  cptCode              String?
  revenueCode          String?
  mod1                 String?
  mod2                 String?
  mod3                 String?
  mod4                 String?
  deletedAt            DateTime?
  createdBy            String
  updatedBy            String
  deletedBy            String?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  department           Department?                    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  creator              User                           @relation("CreatedProcedures", fields: [createdBy], references: [id])
  updater              User                           @relation("UpdatedProcedures", fields: [updatedBy], references: [id])
  deleter              User?                          @relation("DeletedProcedures", fields: [deletedBy], references: [id])
  categories           ProcedureCategoryOnProcedure[]

  @@index([procedureDescription])
  @@index([cptCode])
  @@index([deletedAt])
  @@map("procedures")
}

model ProcedureCategoryOnProcedure {
  procedureId         String
  procedureCategoryId String
  procedure           Procedure         @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  procedureCategory   ProcedureCategory @relation(fields: [procedureCategoryId], references: [id], onDelete: Cascade)

  @@id([procedureId, procedureCategoryId])
  @@map("procedure_category_on_procedure")
}

model HcpcsCode {
  id            String    @id @default(uuid())
  code          String
  description   String
  effectiveDate DateTime? @db.Date
  expiryDate    DateTime? @db.Date
  deletedAt     DateTime?
  createdBy     String
  updatedBy     String
  deletedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  creator       User      @relation("CreatedHcpcsCodes", fields: [createdBy], references: [id])
  updater       User      @relation("UpdatedHcpcsCodes", fields: [updatedBy], references: [id])
  deleter       User?     @relation("DeletedHcpcsCodes", fields: [deletedBy], references: [id])

  @@index([code])
  @@index([effectiveDate])
  @@index([deletedAt])
  @@map("hcpcs_codes")
}

model DiagnosisCode {
  id            String    @id @default(uuid())
  code          String
  description   String
  effectiveDate DateTime? @db.Date
  expiryDate    DateTime? @db.Date
  isActive      Boolean   @default(true)
  codingNotes   String?
  deletedAt     DateTime?
  createdBy     String
  updatedBy     String
  deletedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  creator       User      @relation("CreatedDiagnosisCodes", fields: [createdBy], references: [id])
  updater       User      @relation("UpdatedDiagnosisCodes", fields: [updatedBy], references: [id])
  deleter       User?            @relation("DeletedDiagnosisCodes", fields: [deletedBy], references: [id])
  patientProblems PatientProblem[]

  @@index([code])
  @@index([effectiveDate])
  @@index([isActive])
  @@index([deletedAt])
  @@map("diagnosis_codes")
}

model ChargeMaster {
  id                   String    @id @default(uuid())
  cptCode              String
  description          String
  revenueCode          String
  priceEffectiveDate   DateTime  @db.Date
  cptEffectiveDate     DateTime? @db.Date
  standardAmount       Decimal   @db.Decimal(12, 2)
  totalRevenue         Decimal?  @db.Decimal(14, 2)
  totalVolume          Decimal?  @db.Decimal(12, 2)
  percentageIncreased  Decimal?  @default(0) @db.Decimal(8, 2)
  category             String?
  genericDepartment    String?
  discountPercent      Decimal?  @default(0) @db.Decimal(8, 2)
  location             String
  payer                String?
  isActive             Boolean   @default(true)
  deletedAt            DateTime?
  createdBy            String
  updatedBy            String
  deletedBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  creator              User      @relation("CreatedChargeMasters", fields: [createdBy], references: [id])
  updater              User      @relation("UpdatedChargeMasters", fields: [updatedBy], references: [id])
  deleter              User?     @relation("DeletedChargeMasters", fields: [deletedBy], references: [id])

  @@index([cptCode])
  @@index([revenueCode])
  @@index([location])
  @@index([category])
  @@index([payer])
  @@index([genericDepartment])
  @@index([isActive])
  @@index([deletedAt])
  @@map("charge_masters")
}

model Vaccine {
  id            String    @id @default(uuid())
  vaccineName   String
  vaccineCode   String
  manufacturer  String?
  route         String?
  status        String    @default("Active")
  deletedAt     DateTime?
  createdBy     String
  updatedBy     String
  deletedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  creator       User      @relation("CreatedVaccines", fields: [createdBy], references: [id])
  updater       User      @relation("UpdatedVaccines", fields: [updatedBy], references: [id])
  deleter       User?     @relation("DeletedVaccines", fields: [deletedBy], references: [id])

  @@index([vaccineCode])
  @@index([vaccineName])
  @@index([manufacturer])
  @@index([route])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("vaccines")
}

model RoomType {
  id        String    @id @default(uuid())
  code      String
  label     String
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  deletedAt DateTime?
  createdBy String
  updatedBy String
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  creator   User      @relation("CreatedRoomTypes", fields: [createdBy], references: [id])
  updater   User      @relation("UpdatedRoomTypes", fields: [updatedBy], references: [id])
  deleter   User?     @relation("DeletedRoomTypes", fields: [deletedBy], references: [id])
  rooms     RoomTypeOnRoom[]

  @@index([code])
  @@index([isActive])
  @@index([deletedAt])
  @@map("room_types")
}

model Room {
  id           String           @id @default(uuid())
  roomNumber   String
  displayName  String?
  floor        String?
  unit         String?
  departmentId String?
  status       String           @default("active")
  licensedBeds Int              @default(1)
  notes        String?
  deletedAt    DateTime?
  createdBy    String
  updatedBy    String
  deletedBy    String?
  createdAt    DateTime         @default(now())
