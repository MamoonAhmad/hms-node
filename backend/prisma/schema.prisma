  appointmentStatusesCreated AppointmentStatus[] @relation("CreatedAppointmentStatuses")
  appointmentStatusesUpdated AppointmentStatus[] @relation("UpdatedAppointmentStatuses")
  appointmentStatusesDeleted AppointmentStatus[] @relation("DeletedAppointmentStatuses")
  appointmentTypesCreated    AppointmentType[]    @relation("CreatedAppointmentTypes")
  appointmentTypesUpdated    AppointmentType[]    @relation("UpdatedAppointmentTypes")
  appointmentTypesDeleted    AppointmentType[]    @relation("DeletedAppointmentTypes")
  insuranceProvidersDeleted  InsuranceProvider[]  @relation("DeletedInsuranceProviders")
  chiefComplaintsCreated     ChiefComplaint[]     @relation("CreatedChiefComplaints")
  chiefComplaintsUpdated     ChiefComplaint[]     @relation("UpdatedChiefComplaints")
  chiefComplaintsDeleted     ChiefComplaint[]     @relation("DeletedChiefComplaints")
  chiefComplaintFavourites   UserChiefComplaintFavourite[]
  consentFormsCreated        ConsentForm[]        @relation("CreatedConsentForms")
  consentFormsUpdated        ConsentForm[]        @relation("UpdatedConsentForms")
  consentFormsDeleted        ConsentForm[]        @relation("DeletedConsentForms")
  procedureCategoriesCreated ProcedureCategory[]  @relation("CreatedProcedureCategories")
  procedureCategoriesUpdated ProcedureCategory[]  @relation("UpdatedProcedureCategories")
  procedureCategoriesDeleted ProcedureCategory[]  @relation("DeletedProcedureCategories")
  proceduresCreated          Procedure[]          @relation("CreatedProcedures")
  proceduresUpdated          Procedure[]          @relation("UpdatedProcedures")
  proceduresDeleted          Procedure[]          @relation("DeletedProcedures")
  hcpcsCodesCreated          HcpcsCode[]          @relation("CreatedHcpcsCodes")
  hcpcsCodesUpdated          HcpcsCode[]          @relation("UpdatedHcpcsCodes")
  hcpcsCodesDeleted          HcpcsCode[]          @relation("DeletedHcpcsCodes")
  diagnosisCodesCreated      DiagnosisCode[]      @relation("CreatedDiagnosisCodes")
  diagnosisCodesUpdated      DiagnosisCode[]      @relation("UpdatedDiagnosisCodes")
  diagnosisCodesDeleted      DiagnosisCode[]      @relation("DeletedDiagnosisCodes")
  placeOfServiceCodesCreated PlaceOfServiceCode[] @relation("CreatedPlaceOfServiceCodes")
  placeOfServiceCodesUpdated PlaceOfServiceCode[] @relation("UpdatedPlaceOfServiceCodes")
  placeOfServiceCodesDeleted PlaceOfServiceCode[] @relation("DeletedPlaceOfServiceCodes")
  billingProvidersCreated    BillingProvider[]    @relation("CreatedBillingProviders")
  billingProvidersUpdated    BillingProvider[]    @relation("UpdatedBillingProviders")
  billingProvidersDeleted    BillingProvider[]    @relation("DeletedBillingProviders")
  roomTypesCreated           RoomType[]           @relation("CreatedRoomTypes")
  roomTypesUpdated           RoomType[]           @relation("UpdatedRoomTypes")
  roomTypesDeleted           RoomType[]           @relation("DeletedRoomTypes")
  roomsCreated               Room[]               @relation("CreatedRooms")
  roomsUpdated               Room[]               @relation("UpdatedRooms")
  roomsDeleted               Room[]               @relation("DeletedRooms")
  patientsCreated            Patient[]            @relation("CreatedPatients")
  patientsUpdated            Patient[]            @relation("UpdatedPatients")
  patientsDeleted            Patient[]            @relation("DeletedPatients")
  assignedPatients           Patient[]            @relation("AssignedPatients")
  patientConsentSignatures   PatientConsentSignature[] @relation("PatientConsentSignatures")
  patientProblemsCreated     PatientProblem[]          @relation("CreatedPatientProblems")
  patientProblemsUpdated     PatientProblem[]          @relation("UpdatedPatientProblems")
  customOrderSetsCreated     CustomOrderSet[]          @relation("CreatedCustomOrderSets")
  customOrderSetsUpdated     CustomOrderSet[]          @relation("UpdatedCustomOrderSets")
  customOrderSetsDeleted     CustomOrderSet[]          @relation("DeletedCustomOrderSets")
  customOrderSetsOwned       CustomOrderSet[]          @relation("CustomOrderSetOwner")
  ordersCreated              Order[]                   @relation("CreatedOrders")
  ordersUpdated              Order[]                   @relation("UpdatedOrders")
  ordersDeleted              Order[]                   @relation("DeletedOrders")

  @@map("users")
}

model Tenant {
  id          String     @id @default(uuid())
  name        String
  isActive    Boolean    @default(true)
  createdBy   String
  updatedBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  creator     User       @relation("CreatedTenants", fields: [createdBy], references: [id])
  updater     User       @relation("UpdatedTenants", fields: [updatedBy], references: [id])
  locations   Location[]

  @@map("tenants")
}

model Location {
  id                 String   @id @default(uuid())
  name               String
  address            String?
  city               String?
  state              String?
  country            String?
  phone              String?
  hasOnsiteLab       Boolean  @default(true)
  hasOnsitePharmacy  Boolean  @default(true)
  hasOnsiteRadiology Boolean  @default(true)
  isActive           Boolean  @default(true)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator   User     @relation("CreatedLocations", fields: [createdBy], references: [id])
  updater   User     @relation("UpdatedLocations", fields: [updatedBy], references: [id])
  departments Department[]
  scheduleLinks ProviderScheduleLocation[]
  appointments Appointment[]
  claims       PatientClaim[] @relation("ClaimFacility")

  @@map("locations")
}

model ProviderSchedule {
  id                     String   @id @default(uuid())
  providerId             String
  provider               Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  days                   String[]
  startTime              String
  endTime                String
  slotDuration           Int
  maxAppointmentsPerSlot Int      @default(1)
  overBooking            Int      @default(0)
  effectiveStartDate     DateTime @db.Date
  effectiveEndDate       DateTime? @db.Date
  endOnEffectiveDate     Boolean  @default(false)
  status                 String   @default("Active")
  teleconsultationAllowed Boolean @default(false)
  deletedAt              DateTime?
  createdBy              String?
  updatedBy              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  locations              ProviderScheduleLocation[]
  appointmentTypes       ProviderScheduleAppointmentType[]

  @@index([providerId])
  @@index([deletedAt])
  @@index([effectiveStartDate])
  @@map("provider_schedules")
}

model ProviderScheduleLocation {
  scheduleId String
  locationId String
  schedule   ProviderSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  location   Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([scheduleId, locationId])
  @@map("provider_schedule_locations")
}

model ProviderScheduleAppointmentType {
  scheduleId        String
  appointmentTypeId String
  schedule          ProviderSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  appointmentType   AppointmentType  @relation(fields: [appointmentTypeId], references: [id], onDelete: Cascade)

  @@id([scheduleId, appointmentTypeId])
  @@map("provider_schedule_appointment_types")
}

model ProviderBlockHour {
  id                 String    @id @default(uuid())
  providerId         String
  provider           Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  days               String[]
  startTime          String
  endTime            String
  effectiveStartDate DateTime  @db.Date
  effectiveEndDate   DateTime? @db.Date
  reason             String?
  status             String    @default("Active")
  deletedAt          DateTime?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([providerId])
  @@index([deletedAt])
  @@map("provider_block_hours")
}

model Department {
  id                         String    @id @default(uuid())
  departmentName             String
  departmentCode             String    @unique
  departmentType             String?
  status                     String    @default("active")
  description                String?
  facilityName               String?
  building                   String?
  floor                      String?
  roomNumber                 String?
  address                    String?
  city                       String?
  state                      String?
  zip                        String?
  supportsAppointments       Boolean   @default(false)
  supportsWalkIns            Boolean   @default(false)
  defaultAppointmentDuration Int?
  operatingDays              Json?
  startTime                  String?
  endTime                    String?
  departmentHead             String?
  assignedProviders          Json?
  assignedNurses             Json?
  defaultBillingProvider     String?
  costCenter                 String?
  revenueCode                String?
  acceptsInsurance           Boolean   @default(false)
  locationId                 String?
  location                   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  providers                  Provider[]
  appointments               Appointment[]
  waitlistEntries            WaitlistEntry[]
  procedures                   Procedure[]
  customOrderSets              CustomOrderSet[]
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@map("departments")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique // e.g., "patient.read", "patient.create"
  description String?
  resource    String           // e.g., "patient", "appointment", "tenant"
  action      String           // e.g., "read", "create", "update", "delete"
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isActive    Boolean          @default(true)
  createdBy   String
  updatedBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  creator     User             @relation("CreatedRoles", fields: [createdBy], references: [id])
  updater     User             @relation("UpdatedRoles", fields: [updatedBy], references: [id])
  permissions RolePermission[]

  @@map("roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}
