  sentToPortalAt   DateTime?
  emailedAt        DateTime?
  createdBy        String?
  createdByName    String?
  updatedBy        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  checkout         PatientCheckout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@index([checkoutId])
  @@index([instructionType])
  @@map("patient_checkout_instructions")
}

model PatientCheckoutNote {
  id          String          @id @default(uuid())
  checkoutId  String
  noteType    String          @default("general")
  content     String          @db.Text
  authorId    String?
  authorName  String?
  createdAt   DateTime        @default(now())
  checkout    PatientCheckout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@index([checkoutId])
  @@index([noteType])
  @@map("patient_checkout_notes")
}

model PatientCheckoutTask {
  id             String          @id @default(uuid())
  checkoutId     String
  title          String
  assignedTo     String?
  assignedToName String?
  dueDate        DateTime?       @db.Date
  priority       String          @default("Normal")
  notes          String?         @db.Text
  status         String          @default("Open")
  createdBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  checkout       PatientCheckout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@index([checkoutId])
  @@index([status])
  @@map("patient_checkout_tasks")
}

model PatientCheckoutPayment {
  id               String          @id @default(uuid())
  checkoutId       String
  amountDue        Decimal?        @db.Decimal(10, 2)
  paymentAmount    Decimal         @db.Decimal(10, 2)
  paymentMethod    String
  transactionRef   String?
  notes            String?         @db.Text
  balanceRemaining Decimal?        @db.Decimal(10, 2)
  receiptNumber    String?         @unique
  collectedBy      String?
  collectedByName  String?
  createdAt        DateTime        @default(now())
  checkout         PatientCheckout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@index([checkoutId])
  @@index([createdAt])
  @@map("patient_checkout_payments")
}

model PatientCheckoutAuditLog {
  id         String          @id @default(uuid())
  checkoutId String
  action     String
  details    Json?
  userId     String?
  userName   String?
  createdAt  DateTime        @default(now())
  checkout   PatientCheckout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@index([checkoutId])
  @@index([createdAt])
  @@map("patient_checkout_audit_logs")
}

/// Encounter-level coding / charge capture (CMS-1500 boxes 21–24 inputs).
model EncounterChargeCapture {
  id                     String    @id @default(uuid())
  patientId              String
  appointmentId          String    @unique
  status                 String    @default("draft") // draft | locked
  placeOfService         String    @default("11")
  dateOfService          DateTime  @db.Date
  renderingProviderId    String?
  renderingProviderNpi   String?
  renderingProviderName  String?
  billingProviderName   String?
  billingProviderNpi     String?
  billingProviderTaxId   String?
  authorizationNumber    String?
  referralNumber         String?
  notes                  String?   @db.Text
  isLocked               Boolean   @default(false)
  lockedAt               DateTime?
  lockedBy               String?
  lockedByName           String?
  createdBy              String?
  updatedBy              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  patient                Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment            Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  renderingProvider      Provider? @relation("ChargeCaptureRenderingProvider", fields: [renderingProviderId], references: [id], onDelete: SetNull)
  diagnoses              EncounterDiagnosis[]
  serviceLines           EncounterServiceLine[]
  claims                 Claim[]

  @@index([patientId])
  @@index([status])
  @@index([dateOfService])
  @@map("encounter_charge_captures")
}

model EncounterDiagnosis {
  id              String                 @id @default(uuid())
  chargeCaptureId String
  sequence        Int
  icd10Code       String
  description     String?
  diagnosisCodeId String?
  problemId       String?
  isPrimary       Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  chargeCapture   EncounterChargeCapture @relation(fields: [chargeCaptureId], references: [id], onDelete: Cascade)
  problem         PatientProblem?        @relation(fields: [problemId], references: [id], onDelete: SetNull)

  @@unique([chargeCaptureId, sequence])
  @@index([chargeCaptureId])
  @@index([icd10Code])
  @@index([problemId])
  @@map("encounter_diagnoses")
}

model EncounterServiceLine {
  id                String                 @id @default(uuid())
  chargeCaptureId   String
  lineNumber        Int
  serviceDate       DateTime               @db.Date
  procedureCode     String
  codeType          String                 @default("CPT") // CPT | HCPCS
  description       String?
  modifier1         String?
  modifier2         String?
  modifier3         String?
  modifier4         String?
  units             Decimal                @default(1) @db.Decimal(10, 2)
  chargeAmount      Decimal                @db.Decimal(10, 2)
  diagnosisPointers String                 @default("1")
  placeOfService    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  chargeCapture     EncounterChargeCapture @relation(fields: [chargeCaptureId], references: [id], onDelete: Cascade)

  @@unique([chargeCaptureId, lineNumber])
  @@index([chargeCaptureId])
  @@index([procedureCode])
  @@map("encounter_service_lines")
}

/// Professional claim generated from a locked encounter charge capture.
model Claim {
  id                      String    @id @default(uuid())
  claimNumber             String    @unique
  patientId               String
  appointmentId           String
  chargeCaptureId         String?
  status                  String    @default("Draft") // Draft | Ready | Submitted
  claimType               String    @default("original")
  dateOfService           DateTime  @db.Date
  placeOfService          String    @default("11")
  totalCharge             Decimal   @default(0) @db.Decimal(12, 2)
  patientFirstName        String?
  patientLastName         String?
  patientMrn              String?
  patientDateOfBirth      DateTime? @db.Date
  patientGender           String?
  patientAddress          String?
  patientCity             String?
  patientState            String?
  patientZip              String?
  patientPhone            String?
  subscriberFirstName     String?
  subscriberLastName      String?
  subscriberMemberId      String?
  subscriberGroupNumber   String?
  subscriberRelationship  String?
  payerName               String?
  payerId                 String?
  insuranceType           String?
  authorizationNumber     String?
  referralNumber          String?
  renderingProviderId     String?
  renderingProviderNpi    String?
  renderingProviderName   String?
  billingProviderName    String?
  billingProviderNpi      String?
  billingProviderTaxId    String?
  encounterNumber         String?
  notes                   String?   @db.Text
  readyAt                 DateTime?
  readyBy                 String?
  readyByName             String?
  submittedAt             DateTime?
  submittedBy             String?
  submittedByName         String?
  createdBy               String?
  updatedBy               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  patient                 Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment             Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  chargeCapture           EncounterChargeCapture? @relation(fields: [chargeCaptureId], references: [id], onDelete: SetNull)
  renderingProvider       Provider? @relation("ClaimRenderingProvider", fields: [renderingProviderId], references: [id], onDelete: SetNull)
  diagnoses               ClaimDiagnosis[]
  serviceLines            ClaimServiceLine[]

  @@index([patientId])
  @@index([appointmentId])
  @@index([chargeCaptureId])
  @@index([status])
  @@index([dateOfService])
  @@index([claimNumber])
  @@map("claims")
}

model ClaimDiagnosis {
  id          String   @id @default(uuid())
  claimId     String
  sequence    Int
  icd10Code   String
  description String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([claimId, sequence])
  @@index([claimId])
  @@map("claim_diagnoses")
}

model ClaimServiceLine {
  id                String   @id @default(uuid())
  claimId           String
  lineNumber        Int
  serviceDate       DateTime @db.Date
  procedureCode     String
  codeType          String   @default("CPT")
  description       String?
  modifier1         String?
  modifier2         String?
  modifier3         String?
  modifier4         String?
  units             Decimal  @default(1) @db.Decimal(10, 2)
  chargeAmount      Decimal  @db.Decimal(10, 2)
  diagnosisPointers String   @default("1")
  placeOfService    String?
  createdAt         DateTime @default(now())
  claim             Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@unique([claimId, lineNumber])
  @@index([claimId])
  @@map("claim_service_lines")
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  password          String
  name              String?
  role              String     @default("admin") // admin, user
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
