  priorAuthorizations PriorAuthorization[] @relation("AppointmentAuthHistory")
  referrals         ReferralRecord[] @relation("AppointmentReferralHistory")
  ledgerTransactions LedgerTransaction[]
  payments          AppointmentPayment[]
  roomAssignments   RoomAssignment[]
