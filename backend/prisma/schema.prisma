// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id                    String             @id @default(uuid())
  mrn                   String             @unique @default(cuid()) // Medical Record Number
  firstName             String
  middleName            String?
  lastName              String
  suffix                String?
  preferredName         String?
  previousName          String?
  dateOfBirth           DateTime
  gender                String
  genderIdentity        String?
  pronouns              String?
  contactNumber         String
  preferredContactMethod String            @default("cell")
  email                 String?
  address               String?
  addressLine2          String?
  city                  String?
  state                 String?
  zip                   String?
  country               String?            @default("US")
  homePhone             String?
  workPhone             String?
  cellPhone             String?
  governmentIdType      String?
  governmentIdNumber    String?
  birthPlace            String?
  veteranStatus         String?
  disabilityStatus      String?
  tribalAffiliation     String?
  generalNotes          String?            @db.Text
  ethnicity             String?
  sexualOrientation     String?
  race                  String?
  language              String?
  interpreterRequired   Boolean            @default(false)
  interpreterLanguageRequired String?
  maritalStatus         String?
  employmentStatus      String?
  employerName          String?
  occupation            String?
  employerPhoneNumber   String?
  employerStreetAddress String?
  employerCity          String?
  employerState         String?
  employerZip           String?
  otherInfo             String?            @db.Text
  insuranceProviderId   String?
  insuranceProvider     InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id])
  policyNumber          String?
  copay                 Decimal?           @db.Decimal(10, 2)
  deductible            Decimal?           @db.Decimal(10, 2)
  primaryCarePhysician           String?
  referringPhysicianFirstName    String?
  referringPhysicianLastName     String?
  referringPhysicianNpi          String?
  referringPhysicianPhone        String?
  referringPhysicianFax          String?
  referringPhysicianAddress      String?
  referringPhysicianCity         String?
  referringPhysicianState        String?
  referringPhysicianZip          String?
  profilePhoto          String?            @db.Text
  emergencyContactName              String?
  emergencyContactNumber            String?
  emergencyContactRelationship      String?
  emergencyContactEmail             String?
  emergencyContactAddress           String?
  emergencyContactCity              String?
  emergencyContactState             String?
  emergencyContactZip               String?
  secondaryEmergencyContactName     String?
  secondaryEmergencyContactRelationship String?
  secondaryEmergencyContactNumber   String?
  secondaryEmergencyContactEmail    String?
  guarantorName                     String?
  guarantorPhone                    String?
  guarantorRelationship             String?
  guarantorEmail                    String?
  guarantorAddress                  String?
  guarantorCity                     String?
  guarantorState                    String?
  guarantorZip                      String?
  guarantorDateOfBirth              DateTime?
  authorizedRepresentativeName      String?
  authorizedRepresentativeRelationship String?
  authorizedRepresentativePhone     String?
  authorizedRepresentativeEmail     String?
  legalGuardianName                 String?
  legalGuardianRelationship         String?
  legalGuardianPhone                String?
  legalGuardianEmail                String?
  patientIsMinor                    Boolean            @default(false)
  primaryNextOfKinName              String?
  primaryNextOfKinRelationship      String?
  primaryNextOfKinPhone             String?
  secondaryNextOfKinName            String?
  secondaryNextOfKinRelationship    String?
  secondaryNextOfKinPhone           String?
  subscriberPhone                   String?
  subscriberSsnLast4                String?
  subscriberEmployer                String?
  subscriberAddress                 String?
  subscriberCity                    String?
  subscriberState                   String?
  subscriberZip                     String?
  subscriberEmail                   String?
  registrationStatus                String             @default("pending")
  registrationChannel               String?
  billingType                       String?
  paymentMethod                     String?
  primaryCareProviderId             String?
  assignedToId                      String?
  consentFormSigned                 Boolean            @default(false)
  noKnownDrugAllergies              Boolean            @default(false)
  deletedAt                         DateTime?
  createdBy                         String?
  updatedBy                         String?
  deletedBy                         String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  appointments          Appointment[]
  orders                Order[]
  beds                  Bed[]
  primaryCareProvider   Provider?          @relation("PatientPrimaryCareProvider", fields: [primaryCareProviderId], references: [id], onDelete: SetNull)
  assignedTo            User?              @relation("AssignedPatients", fields: [assignedToId], references: [id], onDelete: SetNull)
  creator               User?              @relation("CreatedPatients", fields: [createdBy], references: [id], onDelete: SetNull)
  updater               User?              @relation("UpdatedPatients", fields: [updatedBy], references: [id], onDelete: SetNull)
  deleter               User?              @relation("DeletedPatients", fields: [deletedBy], references: [id], onDelete: SetNull)
  insurances            PatientInsurance[]
  documents             PatientDocument[]
  consentSignatures     PatientConsentSignature[]
  problems              PatientProblem[]
  allergies             PatientAllergy[]
  eligibilityChecks     InsuranceEligibility[]

  @@index([registrationStatus])
  @@index([assignedToId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("patients")
}

model PatientInsurance {
  id                      String            @id @default(uuid())
  patientId               String
  insuranceType           String
  insuranceProviderId     String
  memberId                String
  policyType              String?
  planName                String?
  groupNumber             String?
  subscriberFirstName     String?
  subscriberLastName      String?
  subscriberRelationship  String?
  subscriberGender        String?
  subscriberDateOfBirth   DateTime?
  subscriberPhone         String?
  subscriberEmail         String?
  subscriberSsnLast4      String?
  subscriberEmployer      String?
  subscriberStreetAddress String?
  subscriberCity          String?
  subscriberState         String?
  subscriberZip           String?
  coverageStartDate       DateTime?         @db.Date
  coverageEndDate         DateTime?         @db.Date
  coinsurancePercentage   Decimal?          @db.Decimal(5, 2)
  copay                   Decimal?          @db.Decimal(10, 2)
  deductible              Decimal?          @db.Decimal(10, 2)
  authorizationNumber     String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  patient                 Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  insuranceProvider       InsuranceProvider @relation(fields: [insuranceProviderId], references: [id], onDelete: Restrict)

  @@unique([patientId, insuranceType])
  @@index([patientId])
  @@index([insuranceProviderId])
  @@map("patient_insurances")
}

model PatientDocument {
  id           String   @id @default(uuid())
  patientId    String
  documentType String
  fileName     String?
  fileData     String?  @db.Text
  mimeType     String?
  uploadedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([documentType])
  @@map("patient_documents")
}

model PatientConsentSignature {
  id              String      @id @default(uuid())
  patientId       String
  consentFormId   String
  signedAt        DateTime    @default(now())
  signedByUserId  String?
  signatureType   String
  signatureData   String      @db.Text
  scrolledToEnd   Boolean     @default(false)
  nameMatched     Boolean     @default(false)
  patient         Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consentForm     ConsentForm @relation(fields: [consentFormId], references: [id], onDelete: Restrict)
  signedBy        User?       @relation("PatientConsentSignatures", fields: [signedByUserId], references: [id], onDelete: SetNull)

  @@unique([patientId, consentFormId])
  @@index([patientId])
  @@map("patient_consent_signatures")
}

model PatientProblem {
  id             String    @id @default(uuid())
  patientId      String
  problemCode    String?
  description    String
  status         String    @default("Active")
  clinicalStatus String?
  verification   String?
  onsetDate      DateTime? @db.Date
  resolvedDate   DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
  @@map("patient_problems")
}

model PatientAllergy {
  id           String    @id @default(uuid())
  patientId    String
  allergenName String
  reaction     String?
  severity     String?
  onsetDate    DateTime? @db.Date
  status       String    @default("Active")
  comment      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
  @@map("patient_allergies")
}

model InsuranceEligibility {
  id         String    @id @default(uuid())
  patientId  String
  status     String
  verifiedAt DateTime?
  payerName  String?
  memberId   String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([status])
  @@map("insurance_eligibility_verifications")
}

model InsuranceProvider {
  id           String    @id @default(uuid())
  name         String
  code         String? // Short code like "BCBS", "AETNA"
  phone        String?
  email        String?
  address      String?
  city         String?
  state        String?
  zip          String?
  website      String?
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  deletedBy    String?
  patients     Patient[]
  patientInsurances PatientInsurance[]
  deleter      User?     @relation("DeletedInsuranceProviders", fields: [deletedBy], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([deletedAt])
  @@map("insurance_providers")
}

model ChiefComplaint {
  id         String    @id @default(uuid())
  name       String
  code       String?
  isActive   Boolean   @default(true)
  sortOrder  Int       @default(0)
  deletedAt  DateTime?
  createdBy  String
  updatedBy  String
  deletedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  creator    User      @relation("CreatedChiefComplaints", fields: [createdBy], references: [id])
  updater    User      @relation("UpdatedChiefComplaints", fields: [updatedBy], references: [id])
  deleter    User?     @relation("DeletedChiefComplaints", fields: [deletedBy], references: [id])
  favourites UserChiefComplaintFavourite[]

  @@index([name])
  @@index([deletedAt])
  @@map("chief_complaints")
}

model UserChiefComplaintFavourite {
  userId           String
  chiefComplaintId String
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chiefComplaint   ChiefComplaint @relation(fields: [chiefComplaintId], references: [id], onDelete: Cascade)

  @@id([userId, chiefComplaintId])
  @@map("user_chief_complaint_favourites")
}

model ConsentForm {
  id                         String    @id @default(uuid())
  consentTitle               String
  consentType                String
  description                String?
  consentContent             String    @db.Text
  isMandatory                Boolean   @default(false)
  isSignatureRequired        Boolean   @default(true)
  patientSignaturePlacement  String?
  requiresWitnessSignature   Boolean   @default(false)
  witnessSignaturePlacement  String?
  requiresProviderSignature  Boolean   @default(false)
  providerSignaturePlacement String?
  effectiveDate              DateTime? @db.Date
  expiryDate                 DateTime? @db.Date
  status                     String    @default("draft")
  department                 String?
  language                   String?
  versionNumber              String?
  tags                       String?
  attachmentName             String?
  attachmentDataUrl          String?   @db.Text
  deletedAt                  DateTime?
  createdBy                  String
  updatedBy                  String
  deletedBy                  String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  creator                    User      @relation("CreatedConsentForms", fields: [createdBy], references: [id])
  updater                    User      @relation("UpdatedConsentForms", fields: [updatedBy], references: [id])
  deleter                    User?     @relation("DeletedConsentForms", fields: [deletedBy], references: [id])
  patientSignatures          PatientConsentSignature[]

  @@index([consentTitle])
  @@index([consentType])
  @@index([status])
  @@index([deletedAt])
  @@map("consent_forms")
}

model ProcedureCategory {
  id         String                         @id @default(uuid())
  name       String
  deletedAt  DateTime?
  createdBy  String
  updatedBy  String
  deletedBy  String?
  createdAt  DateTime                       @default(now())
  updatedAt  DateTime                       @updatedAt
  creator    User                           @relation("CreatedProcedureCategories", fields: [createdBy], references: [id])
  updater    User                           @relation("UpdatedProcedureCategories", fields: [updatedBy], references: [id])
  deleter    User?                          @relation("DeletedProcedureCategories", fields: [deletedBy], references: [id])
  procedures ProcedureCategoryOnProcedure[]

  @@index([name])
  @@index([deletedAt])
  @@map("procedure_categories")
}

model Procedure {
  id                   String                         @id @default(uuid())
  procedureDescription String
  genericDescription   String?
  departmentId         String?
  cptCode              String?
  revenueCode          String?
  mod1                 String?
  mod2                 String?
  mod3                 String?
  mod4                 String?
  deletedAt            DateTime?
  createdBy            String
  updatedBy            String
  deletedBy            String?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  department           Department?                    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  creator              User                           @relation("CreatedProcedures", fields: [createdBy], references: [id])
  updater              User                           @relation("UpdatedProcedures", fields: [updatedBy], references: [id])
  deleter              User?                          @relation("DeletedProcedures", fields: [deletedBy], references: [id])
  categories           ProcedureCategoryOnProcedure[]

  @@index([procedureDescription])
  @@index([cptCode])
  @@index([deletedAt])
  @@map("procedures")
}

model ProcedureCategoryOnProcedure {
  procedureId         String
  procedureCategoryId String
  procedure           Procedure         @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  procedureCategory   ProcedureCategory @relation(fields: [procedureCategoryId], references: [id], onDelete: Cascade)

  @@id([procedureId, procedureCategoryId])
  @@map("procedure_category_on_procedure")
}

model HcpcsCode {
  id            String    @id @default(uuid())
  code          String
  description   String
  effectiveDate DateTime? @db.Date
  expiryDate    DateTime? @db.Date
  deletedAt     DateTime?
  createdBy     String
  updatedBy     String
  deletedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  creator       User      @relation("CreatedHcpcsCodes", fields: [createdBy], references: [id])
  updater       User      @relation("UpdatedHcpcsCodes", fields: [updatedBy], references: [id])
  deleter       User?     @relation("DeletedHcpcsCodes", fields: [deletedBy], references: [id])

  @@index([code])
  @@index([effectiveDate])
  @@index([deletedAt])
  @@map("hcpcs_codes")
}

model DiagnosisCode {
  id            String    @id @default(uuid())
  code          String
  description   String
  effectiveDate DateTime? @db.Date
  expiryDate    DateTime? @db.Date
  isActive      Boolean   @default(true)
  codingNotes   String?
  deletedAt     DateTime?
  createdBy     String
  updatedBy     String
  deletedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  creator       User      @relation("CreatedDiagnosisCodes", fields: [createdBy], references: [id])
  updater       User      @relation("UpdatedDiagnosisCodes", fields: [updatedBy], references: [id])
  deleter       User?     @relation("DeletedDiagnosisCodes", fields: [deletedBy], references: [id])

  @@index([code])
  @@index([effectiveDate])
  @@index([isActive])
  @@index([deletedAt])
  @@map("diagnosis_codes")
}

model RoomType {
  id        String    @id @default(uuid())
  code      String
  label     String
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  deletedAt DateTime?
  createdBy String
  updatedBy String
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  creator   User      @relation("CreatedRoomTypes", fields: [createdBy], references: [id])
  updater   User      @relation("UpdatedRoomTypes", fields: [updatedBy], references: [id])
  deleter   User?     @relation("DeletedRoomTypes", fields: [deletedBy], references: [id])
  rooms     RoomTypeOnRoom[]

  @@index([code])
  @@index([isActive])
  @@index([deletedAt])
  @@map("room_types")
}

model Room {
  id           String           @id @default(uuid())
  roomNumber   String
  displayName  String?
  floor        String?
  unit         String?
  status       String           @default("active")
  licensedBeds Int              @default(1)
  notes        String?
  deletedAt    DateTime?
  createdBy    String
  updatedBy    String
  deletedBy    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  creator      User             @relation("CreatedRooms", fields: [createdBy], references: [id])
  updater      User             @relation("UpdatedRooms", fields: [updatedBy], references: [id])
  deleter      User?            @relation("DeletedRooms", fields: [deletedBy], references: [id])
  roomTypes    RoomTypeOnRoom[]
  beds         Bed[]
  appointments Appointment[]

  @@index([roomNumber])
  @@index([status])
  @@index([deletedAt])
  @@map("rooms")
}

model RoomTypeOnRoom {
  roomId     String
  roomTypeId String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  @@id([roomId, roomTypeId])
  @@map("room_type_on_room")
}

model Bed {
  id        String    @id @default(uuid())
  bedLabel  String
  roomId    String
  status    String    @default("available")
  patientId String?
  service   String?
  notes     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  room      Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  patient   Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([roomId])
  @@index([patientId])
  @@index([status])
  @@index([deletedAt])
  @@map("beds")
}

model Provider {
  id                       String   @id @default(uuid())
  npi                      String   @unique
  initials                 String?
  firstName                String
  middleName               String?
  lastName                 String
  gender                   String?
  dateOfBirth              DateTime?
  specialtyId              String?
  specialty                Specialty?   @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  subSpecialtyId           String?
  subSpecialty             SubSpecialty? @relation(fields: [subSpecialtyId], references: [id], onDelete: SetNull)
  departmentId             String?
  department               Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  taxonomy                 String?
  email                    String?
  taxId                    String?
  group                    String?
  deaNumber                String?
  deaEffectiveDate         DateTime?
  deaExpiryDate            DateTime?
  stateLicenseNumber       String?
  stateLicenseEffectiveDate DateTime?
  stateLicenseExpiryDate   DateTime?
  csrLicenseNumber         String?
  csrExpiryDate            DateTime?
  mobileNumber             String?
  degree                   String?
  experience               String?
  address                  String?
  city                     String?
  state                    String?
  zip                      String?
  treatment                String?
  cprsTabEffectiveDate     DateTime?
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  schedules                ProviderSchedule[]
  blockHours               ProviderBlockHour[]
  appointments             Appointment[]
  primaryCarePatients      Patient[] @relation("PatientPrimaryCareProvider")

  @@map("providers")
}

model Specialty {
  id           String        @id @default(uuid())
  name         String        @unique
  code         String?       @unique
  isActive     Boolean       @default(true)
  subSpecialties SubSpecialty[]
  providers    Provider[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("specialties")
}

model SubSpecialty {
  id          String    @id @default(uuid())
  specialtyId String
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  isActive    Boolean   @default(true)
  providers   Provider[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([specialtyId, name])
  @@unique([specialtyId, code])
  @@map("sub_specialties")
}

model AppointmentType {
  id          String    @id @default(uuid())
  name        String
  description String?
  defaultTime Float?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  createdBy   String
  updatedBy   String
  deletedBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  creator     User      @relation("CreatedAppointmentTypes", fields: [createdBy], references: [id])
  updater     User      @relation("UpdatedAppointmentTypes", fields: [updatedBy], references: [id])
  deleter     User?     @relation("DeletedAppointmentTypes", fields: [deletedBy], references: [id])

  scheduleLinks ProviderScheduleAppointmentType[]
  appointments  Appointment[]

  @@index([name])
  @@index([deletedAt])
  @@map("appointment_types")
}

model AppointmentStatus {
  id        String    @id @default(uuid())
  name      String
  color     String    @default("#3b82f6")
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  deletedAt DateTime?
  createdBy String
  updatedBy String
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  creator   User      @relation("CreatedAppointmentStatuses", fields: [createdBy], references: [id])
  updater   User      @relation("UpdatedAppointmentStatuses", fields: [updatedBy], references: [id])
  deleter   User?     @relation("DeletedAppointmentStatuses", fields: [deletedBy], references: [id])

  @@index([name])
  @@index([deletedAt])
  @@map("appointment_statuses")
}

model Appointment {
  id                String   @id @default(uuid())
  encounterNumber   String   @unique
  appointmentDate   DateTime @db.Date
  appointmentTime   String
  appointmentEndTime String?
  duration             Int      @default(30)
  appointmentTypeId    String
  appointmentTypeRef   AppointmentType @relation(fields: [appointmentTypeId], references: [id], onDelete: Restrict)
  visitReason          String?
  department        String?
  departmentId      String?
  provider          String?
  providerId        String?
  status            String   @default("Scheduled")
  notes             String?
  roomId            String?
  chiefComplaint    String?
  assignedNurseName String?
  arrivalTime       DateTime?
  checkoutStatus    String?  @default("Pending")
  alertsFlags       Json?
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerRef       Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  departmentRef     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  room              Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  orders            Order[]
  history           AppointmentHistory[]
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([providerId])
  @@index([departmentId])
  @@index([appointmentTypeId])
  @@index([appointmentDate])
  @@index([status])
  @@index([roomId])
  @@map("appointments")
}

model AppointmentHistory {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  action        String
  summary       String?
  changes       Json?
  changedBy     String?
  changedByName String?
  createdAt     DateTime    @default(now())

  @@index([appointmentId])
  @@map("appointment_history")
}

model Order {
  id            String       @id @default(uuid())
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  category      String
  procedureCode String
  procedureName String
  status        String       @default("Scheduled")
  destination   String       @default("onsite")
  site          String?
  orderedBy     String?
  priority      String?      @default("Routine")
  orderDateTime DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([patientId])
  @@index([appointmentId])
  @@index([category, destination])
  @@map("orders")
}

model User {
  id                String     @id @default(uuid())
  email             String     @unique
  password          String
  name              String?
  role              String     @default("admin") // admin, user
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  tenantsCreated    Tenant[]   @relation("CreatedTenants")
  tenantsUpdated    Tenant[]   @relation("UpdatedTenants")
  locationsCreated  Location[] @relation("CreatedLocations")
  locationsUpdated  Location[] @relation("UpdatedLocations")
  rolesCreated      Role[]             @relation("CreatedRoles")
  rolesUpdated      Role[]             @relation("UpdatedRoles")
  appointmentStatusesCreated AppointmentStatus[] @relation("CreatedAppointmentStatuses")
  appointmentStatusesUpdated AppointmentStatus[] @relation("UpdatedAppointmentStatuses")
  appointmentStatusesDeleted AppointmentStatus[] @relation("DeletedAppointmentStatuses")
  appointmentTypesCreated    AppointmentType[]    @relation("CreatedAppointmentTypes")
  appointmentTypesUpdated    AppointmentType[]    @relation("UpdatedAppointmentTypes")
  appointmentTypesDeleted    AppointmentType[]    @relation("DeletedAppointmentTypes")
  insuranceProvidersDeleted  InsuranceProvider[]  @relation("DeletedInsuranceProviders")
  chiefComplaintsCreated     ChiefComplaint[]     @relation("CreatedChiefComplaints")
  chiefComplaintsUpdated     ChiefComplaint[]     @relation("UpdatedChiefComplaints")
  chiefComplaintsDeleted     ChiefComplaint[]     @relation("DeletedChiefComplaints")
  chiefComplaintFavourites   UserChiefComplaintFavourite[]
  consentFormsCreated        ConsentForm[]        @relation("CreatedConsentForms")
  consentFormsUpdated        ConsentForm[]        @relation("UpdatedConsentForms")
  consentFormsDeleted        ConsentForm[]        @relation("DeletedConsentForms")
  procedureCategoriesCreated ProcedureCategory[]  @relation("CreatedProcedureCategories")
  procedureCategoriesUpdated ProcedureCategory[]  @relation("UpdatedProcedureCategories")
  procedureCategoriesDeleted ProcedureCategory[]  @relation("DeletedProcedureCategories")
  proceduresCreated          Procedure[]          @relation("CreatedProcedures")
  proceduresUpdated          Procedure[]          @relation("UpdatedProcedures")
  proceduresDeleted          Procedure[]          @relation("DeletedProcedures")
  hcpcsCodesCreated          HcpcsCode[]          @relation("CreatedHcpcsCodes")
  hcpcsCodesUpdated          HcpcsCode[]          @relation("UpdatedHcpcsCodes")
  hcpcsCodesDeleted          HcpcsCode[]          @relation("DeletedHcpcsCodes")
  diagnosisCodesCreated      DiagnosisCode[]      @relation("CreatedDiagnosisCodes")
  diagnosisCodesUpdated      DiagnosisCode[]      @relation("UpdatedDiagnosisCodes")
  diagnosisCodesDeleted      DiagnosisCode[]      @relation("DeletedDiagnosisCodes")
  roomTypesCreated           RoomType[]           @relation("CreatedRoomTypes")
  roomTypesUpdated           RoomType[]           @relation("UpdatedRoomTypes")
  roomTypesDeleted           RoomType[]           @relation("DeletedRoomTypes")
  roomsCreated               Room[]               @relation("CreatedRooms")
  roomsUpdated               Room[]               @relation("UpdatedRooms")
  roomsDeleted               Room[]               @relation("DeletedRooms")
  patientsCreated            Patient[]            @relation("CreatedPatients")
  patientsUpdated            Patient[]            @relation("UpdatedPatients")
  patientsDeleted            Patient[]            @relation("DeletedPatients")
  assignedPatients           Patient[]            @relation("AssignedPatients")
  patientConsentSignatures   PatientConsentSignature[] @relation("PatientConsentSignatures")

  @@map("users")
}

model Tenant {
  id          String     @id @default(uuid())
  name        String
  isActive    Boolean    @default(true)
  createdBy   String
  updatedBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  creator     User       @relation("CreatedTenants", fields: [createdBy], references: [id])
  updater     User       @relation("UpdatedTenants", fields: [updatedBy], references: [id])
  locations   Location[]

  @@map("tenants")
}

model Location {
  id                 String   @id @default(uuid())
  name               String
  address            String?
  city               String?
  state              String?
  country            String?
  phone              String?
  hasOnsiteLab       Boolean  @default(true)
  hasOnsitePharmacy  Boolean  @default(true)
  hasOnsiteRadiology Boolean  @default(true)
  isActive           Boolean  @default(true)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator   User     @relation("CreatedLocations", fields: [createdBy], references: [id])
  updater   User     @relation("UpdatedLocations", fields: [updatedBy], references: [id])
  departments Department[]
  scheduleLinks ProviderScheduleLocation[]

  @@map("locations")
}

model ProviderSchedule {
  id                     String   @id @default(uuid())
  providerId             String
  provider               Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  days                   String[]
  startTime              String
  endTime                String
  slotDuration           Int
  maxAppointmentsPerSlot Int      @default(1)
  overBooking            Int      @default(0)
  effectiveStartDate     DateTime @db.Date
  effectiveEndDate       DateTime? @db.Date
  endOnEffectiveDate     Boolean  @default(false)
  status                 String   @default("Active")
  teleconsultationAllowed Boolean @default(false)
  deletedAt              DateTime?
  createdBy              String?
  updatedBy              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  locations              ProviderScheduleLocation[]
  appointmentTypes       ProviderScheduleAppointmentType[]

  @@index([providerId])
  @@index([deletedAt])
  @@index([effectiveStartDate])
  @@map("provider_schedules")
}

model ProviderScheduleLocation {
  scheduleId String
  locationId String
  schedule   ProviderSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  location   Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([scheduleId, locationId])
  @@map("provider_schedule_locations")
}

model ProviderScheduleAppointmentType {
  scheduleId        String
  appointmentTypeId String
  schedule          ProviderSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  appointmentType   AppointmentType  @relation(fields: [appointmentTypeId], references: [id], onDelete: Cascade)

  @@id([scheduleId, appointmentTypeId])
  @@map("provider_schedule_appointment_types")
}

model ProviderBlockHour {
  id                 String    @id @default(uuid())
  providerId         String
  provider           Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  days               String[]
  startTime          String
  endTime            String
  effectiveStartDate DateTime  @db.Date
  effectiveEndDate   DateTime? @db.Date
  reason             String?
  status             String    @default("Active")
  deletedAt          DateTime?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([providerId])
  @@index([deletedAt])
  @@map("provider_block_hours")
}

model Department {
  id                         String    @id @default(uuid())
  departmentName             String
  departmentCode             String    @unique
  departmentType             String?
  status                     String    @default("active")
  description                String?
  facilityName               String?
  building                   String?
  floor                      String?
  roomNumber                 String?
  address                    String?
  city                       String?
  state                      String?
  zip                        String?
  supportsAppointments       Boolean   @default(false)
  supportsWalkIns            Boolean   @default(false)
  defaultAppointmentDuration Int?
  operatingDays              Json?
  startTime                  String?
  endTime                    String?
  departmentHead             String?
  assignedProviders          Json?
  assignedNurses             Json?
  defaultBillingProvider     String?
  costCenter                 String?
  revenueCode                String?
  acceptsInsurance           Boolean   @default(false)
  locationId                 String?
  location                   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  providers                  Provider[]
  appointments               Appointment[]
  procedures                   Procedure[]
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@map("departments")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique // e.g., "patient.read", "patient.create"
  description String?
  resource    String           // e.g., "patient", "appointment", "tenant"
  action      String           // e.g., "read", "create", "update", "delete"
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isActive    Boolean          @default(true)
  createdBy   String
  updatedBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  creator     User             @relation("CreatedRoles", fields: [createdBy], references: [id])
  updater     User             @relation("UpdatedRoles", fields: [updatedBy], references: [id])
  permissions RolePermission[]

  @@map("roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}
