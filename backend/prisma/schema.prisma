model Tenant {
  id          String     @id @default(uuid())
  name        String
  isActive    Boolean    @default(true)
  createdBy   String
  updatedBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  creator     User       @relation("CreatedTenants", fields: [createdBy], references: [id])
  updater     User       @relation("UpdatedTenants", fields: [updatedBy], references: [id])
  locations   Location[]

  @@map("tenants")
}

model Location {
  id                 String   @id @default(uuid())
  name               String
  address            String?
  city               String?
  state              String?
  country            String?
  phone              String?
  hasOnsiteLab       Boolean  @default(true)
  hasOnsitePharmacy  Boolean  @default(true)
  hasOnsiteRadiology Boolean  @default(true)
  isActive           Boolean  @default(true)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator   User     @relation("CreatedLocations", fields: [createdBy], references: [id])
  updater   User     @relation("UpdatedLocations", fields: [updatedBy], references: [id])
  departments Department[]
  scheduleLinks ProviderScheduleLocation[]

  @@map("locations")
}

model ProviderDepartment {
  providerId   String
  departmentId String
  provider     Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([providerId, departmentId])
  @@index([departmentId])
  @@map("provider_departments")
}

model ProviderSchedule {
  id                     String   @id @default(uuid())
  providerId             String
  provider               Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  departmentId           String?
  department             Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  days                   String[]
  startTime              String
  endTime                String
  slotDuration           Int
  maxAppointmentsPerSlot Int      @default(1)
  overBooking            Int      @default(0)
  breakHoursEnabled      Boolean  @default(false)
  breakStartTime         String?
  breakEndTime           String?
  breakAppliesTo         String?
  breakDays              String[] @default([])
  effectiveStartDate     DateTime @db.Date
  effectiveEndDate       DateTime? @db.Date
  endOnEffectiveDate     Boolean  @default(false)
  status                 String   @default("Active")
  teleconsultationAllowed Boolean @default(false)
  deletedAt              DateTime?
  createdBy              String?
  updatedBy              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  locations              ProviderScheduleLocation[]
  appointmentTypes       ProviderScheduleAppointmentType[]

  @@index([providerId])
  @@index([departmentId])
  @@index([deletedAt])
  @@index([effectiveStartDate])
  @@map("provider_schedules")
}

model ProviderScheduleLocation {
  scheduleId String
  locationId String
  schedule   ProviderSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  location   Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([scheduleId, locationId])
  @@map("provider_schedule_locations")
}

model ProviderScheduleAppointmentType {
  scheduleId        String
  appointmentTypeId String
  schedule          ProviderSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  appointmentType   AppointmentType  @relation(fields: [appointmentTypeId], references: [id], onDelete: Cascade)

  @@id([scheduleId, appointmentTypeId])
  @@map("provider_schedule_appointment_types")
}

model ProviderBlockHour {
  id                 String    @id @default(uuid())
  providerId         String
  provider           Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  days               String[]
  startTime          String
  endTime            String
  effectiveStartDate DateTime  @db.Date
  effectiveEndDate   DateTime? @db.Date
  reason             String?
  status             String    @default("Active")
  deletedAt          DateTime?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([providerId])
  @@index([deletedAt])
  @@map("provider_block_hours")
}

model Department {
  id                         String    @id @default(uuid())
  departmentName             String
  departmentCode             String    @unique
  departmentType             String?
  status                     String    @default("active")
  description                String?
  facilityName               String?
  building                   String?
  floor                      String?
  roomNumber                 String?
  address                    String?
  city                       String?
  state                      String?
  zip                        String?
  supportsAppointments       Boolean   @default(false)
  supportsWalkIns            Boolean   @default(false)
  defaultAppointmentDuration Int?
  operatingDays              Json?
  startTime                  String?
  endTime                    String?
  departmentHead             String?
  assignedProviders          Json?
  assignedNurses             Json?
  defaultBillingProvider     String?
  costCenter                 String?
  revenueCode                String?
  acceptsInsurance           Boolean   @default(false)
  locationId                 String?
  location                   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  providers                  Provider[]
  providerLinks              ProviderDepartment[]
  providerSchedules          ProviderSchedule[]
  appointments               Appointment[]
  procedures                   Procedure[]
  rooms                      Room[]
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@map("departments")
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique // e.g., "patient.read", "patient.create"
  description String?
  resource    String           // e.g., "patient", "appointment", "tenant"
  action      String           // e.g., "read", "create", "update", "delete"
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isActive    Boolean          @default(true)
  createdBy   String
  updatedBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  creator     User             @relation("CreatedRoles", fields: [createdBy], references: [id])
  updater     User             @relation("UpdatedRoles", fields: [updatedBy], references: [id])
  permissions RolePermission[]

  @@map("roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// Metadata: chronic condition definitions available in intake.
model ChronicDiseaseTemplate {
  id           String   @id @default(uuid())
  diseaseCode  String   @unique
  name         String
  defaultIcd   String?
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  fields       ChronicDiseaseTemplateField[]

  @@index([active, displayOrder])
  @@map("chronic_disease_templates")
}

/// Metadata: configurable fields for a chronic condition template.
model ChronicDiseaseTemplateField {
  id           String                 @id @default(uuid())
  templateId   String
  fieldKey     String
  fieldName    String
  fieldType    String
  groupKey     String?
  groupName    String?
  options      Json?
  displayOrder Int                    @default(0)
  required     Boolean                @default(false)
  active       Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  template     ChronicDiseaseTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, fieldKey])
  @@index([templateId, displayOrder])
  @@map("chronic_disease_template_fields")
}

/// One chronic condition documented for a patient encounter.
model ChronicDiseaseEncounter {
  id             String   @id @default(uuid())
  patientId      String
  encounterId    String?
  conditionCode  String
  conditionName  String
  icdCode        String?
  status         String   @default("Active")
  severity       String?
  diagnosisDate  DateTime? @db.Date
  controlStatus  String?
  notes          String?  @db.Text
  createdBy      String?
  updatedBy      String?
  createdByName  String?
  updatedByName  String?
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter      Appointment? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  fieldValues    ChronicDiseaseFieldValue[]

  @@index([patientId])
  @@index([encounterId])
  @@index([conditionCode])
  @@index([isDeleted])
  @@map("chronic_disease_encounters")
}

/// Individual field values for a chronic disease encounter record.
model ChronicDiseaseFieldValue {
  id             String                  @id @default(uuid())
  diseaseRecordId String
  fieldKey       String
  fieldValue     String?                 @db.Text
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  diseaseRecord  ChronicDiseaseEncounter @relation(fields: [diseaseRecordId], references: [id], onDelete: Cascade)

  @@unique([diseaseRecordId, fieldKey])
  @@index([diseaseRecordId])
  @@map("chronic_disease_field_values")
}
